# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000
HOST=127.0.0.1
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Database Configuration
DATABASE_URI=sqlite:///backend/data/phishing_analysis.db

# Machine Learning Settings
ML_MODEL_PATH=models/phishing_model.joblib
TFIDF_VECTORIZER_PATH=models/tfidf_vectorizer.joblib
HYBRID_MODE=true
RULE_WEIGHT=0.6
ML_WEIGHT=0.4
